# Shared SiliconFlow key: set LLM_API_KEY or IMAGE_API_KEY (at least one required)
LLM_API_KEY=sk-your-siliconflow-key-here

# --- Image generation (creative mode) ---
# IMAGE_API_KEY defaults to LLM_API_KEY if not set
# IMAGE_API_KEY=sk-your-image-api-key-here
IMAGE_API_URL=https://api.siliconflow.cn/v1/images/generations
IMAGE_MODEL=Kwai-Kolors/Kolors

# --- Server ---
PORT=3001
# HOST=0.0.0.0

# Persistent shared trial usage (3 lifetime attempts per client IP)
# Default: server/data/trial-quota.json; keep this file across releases/restarts
# QUOTA_STORE_PATH=/var/lib/breakout-maker/trial-quota.json
