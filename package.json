{
  "name": "breakout-maker",
  "version": "2.0.0",
  "private": true,
  "description": "Astral Forge \u2014 a dimensional edition of Breakout Maker",
  "scripts": {
    "predev": "node web/game/build-legacy.cjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node web/game/build-legacy.cjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node web/game/build-legacy.cjs && node test/run-all.js && vitest run test/modern",
    "test:legacy": "node test/run-all.js",
    "format": "prettier --write \"web/**/*.{ts,tsx,css}\" vite.config.ts",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,css}\" vite.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
